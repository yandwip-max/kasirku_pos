# Native PostgreSQL on Windows (no Docker). Replace PASSWORD_POSTGRES with the
# password set during PostgreSQL installation. Hosted Supabase URLs also work.
DATABASE_URL=postgresql://postgres:PASSWORD_POSTGRES@127.0.0.1:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
WEBHOOK_CRON_SECRET=replace-with-a-separate-long-random-secret

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional. Keep this key on the backend; never use a VITE_ prefix for it.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Optional managed email provider key. Required for weekly/daily report delivery.
EMERGENT_EMAIL_KEY=