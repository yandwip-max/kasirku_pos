# Native PostgreSQL on Windows (no Docker). Replace PASSWORD_POSTGRES with the
# password set during PostgreSQL installation. Hosted Supabase URLs also work.
DATABASE_URL=postgresql://postgres:PASSWORD_POSTGRES@127.0.0.1:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
WEBHOOK_CRON_SECRET=replace-with-a-separate-long-random-secret

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional. Keep this key on the backend; never use a VITE_ prefix for it.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Email delivery: set the SMTP_* values (works on Vercel; Gmail needs an App Password,
# host smtp.gmail.com, port 587) OR the managed EMERGENT_EMAIL_KEY. SMTP wins when both exist.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMERGENT_EMAIL_KEY=